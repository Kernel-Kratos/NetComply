# ============================================================
# LLM backend: the ONLY place to change when Gemma 4 is ready.
# Copy this file to .env and edit. No code changes needed.
# ============================================================

# mock          = no model, canned demo output (works with no key, default)
# openai_compat = any server exposing /chat/completions
#                 (Ollama, vLLM, llama.cpp server, or a hosted provider)
LLM_BACKEND=mock

# --- Fill these three in when Gemma 4 access is available ---
# Local example (Ollama):  http://localhost:11434/v1
# Hosted: use your provider's OpenAI-compatible base URL from its docs
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=

# Extra hosts allowed while OFFLINE=1, comma-separated. Use this when a teammate
# hosts the model on your LAN, e.g. LLM_ALLOWED_HOSTS=192.168.1.20
LLM_ALLOWED_HOSTS=

# 1 = refuse any non-localhost endpoint (production / air-gapped)
# 0 = allow a hosted API (development only)
OFFLINE=1

CONFIDENCE_THRESHOLD=0.7
LLM_TIMEOUT_S=60

# Frontend can run against fake data before the backend exists
USE_MOCK_SERVICE=0
